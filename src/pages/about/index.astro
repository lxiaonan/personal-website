---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { experiences, profile, stackGroups } from '../../data/site';
import { withBase } from '../../utils/path';
---

<BaseLayout title="关于" description="关于 Java 后端开发者的经历、技术栈和联系方式。">
  <section class="section">
    <div class="container about-layout grid">
      <div class="prose">
        <p class="eyebrow">About</p>
        <h1 class="section-title">你好，我是{profile.name}。</h1>
        <p>
          我是一名 Java 后端开发者。团队项目中参与媒体花费采集、批创预览与提交、BI 路径分析、资产箱迁移和报表导出；
          个人项目维护 AI 模型接入、聊天积分结算和持久化视频任务。
        </p>
        <p>
          开发中大量使用 AI 生成和修改代码，我负责需求与规则梳理、实现检查及问题修复。
          项目页按个人提交记录具体工作，笔记说明问题、处理过程与验证范围；方案推演另行标注。
        </p>
        <div class="button-row">
          {profile.resume && <a class="button primary" href={withBase(profile.resume)}>下载简历</a>}
          <a class="button" href={profile.github}>GitHub</a>
          <a class="button" href={profile.csdn}>CSDN</a>
          {profile.linuxdo && <a class="button" href={profile.linuxdo}>Linux.do</a>}
        </div>
      </div>

      <aside class="contact-card">
        <h2>Contact</h2>
        <dl>
          {profile.email && <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
          </div>}
          <div>
            <dt>Location</dt>
            <dd>{profile.location}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Java Backend / Distributed Systems</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Capability</p>
      <h2 class="section-title">使用的技术</h2>
      <div class="capability-grid">
        {
          stackGroups.map((group) => (
            <article>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Timeline</p>
      <h2 class="section-title">工作事项摘要</h2>
      <div class="timeline-list">
        {
          experiences.map((item) => (
            <article>
              <span>{item.year}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-layout { grid-template-columns: minmax(0, 1fr) 360px; gap: 72px; align-items: start; }
  .about-layout .prose { max-width: none; }
  .contact-card dd { overflow-wrap: anywhere; }
  .contact-card a:hover { color: var(--accent-strong); }
  @media (max-width: 1000px) { .about-layout { grid-template-columns: 1fr; gap: 32px; } }
  .contact-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .contact-card h2 {
    margin: 0 0 18px;
    font-size: 1.45rem;
  }

  dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  dl div {
    border-bottom: 1px solid var(--line);
    padding-block: 14px;
  }

  dt {
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 720;
  }

  dd {
    margin: 0;
    font-weight: 740;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 26px;
  }

  .capability-grid article {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    background: var(--surface);
  }

  .capability-grid h3 {
    margin: 0 0 10px;
  }

  .capability-grid ul {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    margin: 0;
    color: var(--muted);
  }

  .timeline-list {
    display: grid;
    margin-top: 26px;
    border-top: 1px solid var(--line);
  }

  .timeline-list article {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 18px;
    border-bottom: 1px solid var(--line);
    padding-block: 20px;
  }

  .timeline-list span {
    color: var(--accent);
    font-weight: 780;
  }

  .timeline-list h3 {
    margin: 0 0 6px;
  }

  .timeline-list p {
    margin: 0;
    color: var(--muted);
  }

  @media (min-width: 600px) and (max-width: 860px) {
    .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  }

  @media (max-width: 599px) {
    .capability-grid,
    .timeline-list article {
      grid-template-columns: 1fr;
    }
  }
</style>
