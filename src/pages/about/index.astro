---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { experiences, profile, stackGroups } from '../../data/site';
import { withBase } from '../../utils/path';
---

<BaseLayout title="关于" description="关于 Java 后端开发者的经历、技术栈和联系方式。">
  <section class="section">
    <div class="container about-layout grid">
      <div class="prose">
        <p class="eyebrow">About</p>
        <h1 class="section-title">你好，我是{profile.name}。</h1>
        <p>
          我是一名 Java 后端开发者，参与广告投放、批创和 BI 平台建设，也在迭代自己的 AI 创作平台。
          平时大量使用 AI 生成和修改代码，我把主要精力放在理解业务、拆解流程、约束方案和验证结果上。
        </p>
        <p>
          这个网站记录具体做过什么、踩过什么坑，以及如何把一次修复变成下一次开发的检查点。
          项目页说明负责范围，踩坑笔记保留排查细节，AI 开发总结记录协作方法。
        </p>
        <div class="button-row">
          {profile.resume && <a class="button primary" href={withBase(profile.resume)}>下载简历</a>}
          <a class="button" href={profile.github}>GitHub</a>
          <a class="button" href={profile.csdn}>CSDN</a>
          <a class="button" href={profile.linuxdo}>Linux.do</a>
        </div>
      </div>

      <aside class="contact-card">
        <h2>Contact</h2>
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{profile.location}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Java Backend / Distributed Systems</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Capability</p>
      <h2 class="section-title">能力拼图。</h2>
      <div class="capability-grid">
        {
          stackGroups.map((group) => (
            <article>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Timeline</p>
      <h2 class="section-title">经历摘要。</h2>
      <div class="timeline-list">
        {
          experiences.map((item) => (
            <article>
              <span>{item.year}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-layout { grid-template-columns: minmax(0, 1fr) 360px; gap: 72px; align-items: start; }
  .about-layout .prose { max-width: none; }
  .contact-card dd { overflow-wrap: anywhere; }
  .contact-card a:hover { color: var(--accent-strong); }
  @media (max-width: 1000px) { .about-layout { grid-template-columns: 1fr; gap: 32px; } }
  .contact-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .contact-card h2 {
    margin: 0 0 18px;
    font-size: 1.45rem;
  }

  dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  dl div {
    border-bottom: 1px solid var(--line);
    padding-block: 14px;
  }

  dt {
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 720;
  }

  dd {
    margin: 0;
    font-weight: 740;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 26px;
  }

  .capability-grid article {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    background: var(--surface);
  }

  .capability-grid h3 {
    margin: 0 0 10px;
  }

  .capability-grid ul {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    margin: 0;
    color: var(--muted);
  }

  .timeline-list {
    display: grid;
    margin-top: 26px;
    border-top: 1px solid var(--line);
  }

  .timeline-list article {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 18px;
    border-bottom: 1px solid var(--line);
    padding-block: 20px;
  }

  .timeline-list span {
    color: var(--accent);
    font-weight: 780;
  }

  .timeline-list h3 {
    margin: 0 0 6px;
  }

  .timeline-list p {
    margin: 0;
    color: var(--muted);
  }

  @media (min-width: 600px) and (max-width: 860px) {
    .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  }

  @media (max-width: 599px) {
    .capability-grid,
    .timeline-list article {
      grid-template-columns: 1fr;
    }
  }
</style>
