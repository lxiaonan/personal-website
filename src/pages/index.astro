---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import FeaturedReads from '../components/FeaturedReads.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { capabilities, profile, resourceGroups, stackGroups } from '../data/site';
import { channels } from '../data/channels';
import { projectCard } from '../utils/projects';
import { withBase } from '../utils/path';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articles = posts.filter((post) => post.data.category === 'article').slice(0, 4);
const practiceChannels = (['pitfall', 'ai-development'] as const).map((category) => ({
  ...channels[category],
  category,
  posts: posts.filter((post) => post.data.category === category).slice(0, 2)
}));

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(projectCard);
const skills = await getCollection('skills');
const readingRoutes = [
  { href: '/projects/', label: '了解项目经历', detail: `${projects.length} 个项目 · 负责范围与交付记录` },
  { href: '/blog/', label: '查阅开发笔记', detail: `${posts.filter((post) => post.data.category === 'article').length} 篇文章 · 后端方案与工程实践` },
  { href: '/ai-skills/', label: '找到合适的 AI Skill', detail: `${skills.length} 份指南 · 安装、调用与使用边界` }
];
---

<BaseLayout title="Java Backend Developer" description={profile.intro}>
  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">Java Backend Developer</p>
        <h1>Java 后端开发，<br />记录项目实现与问题修复。</h1>
        <p>{profile.intro}</p>
        <div class="button-row">
          <a class="button primary" href="#start-reading">从精选案例开始</a>
          <a class="button" href={withBase('/projects/')}>查看项目</a>
          {profile.resume && <a class="button" href={withBase(profile.resume)}>简历 PDF</a>}
        </div>
      </div>

      <aside class="profile-card" aria-label="个人概要">
        <div class="avatar">YN</div>
        <div>
          <h2>{profile.name}</h2>
          <p>{profile.handle}</p>
        </div>
        <dl>
          <div>
            <dt>Focus</dt>
            <dd>Backend / Data / AI Products</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{profile.location}</dd>
          </div>
          {profile.email && <div>
            <dt>Contact</dt>
            <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
          </div>}
        </dl>
      </aside>
    </div>
  </section>

  <nav class="container reading-routes" aria-label="按阅读目的浏览">
    {readingRoutes.map((route, index) => (
      <a href={withBase(route.href)}>
        <span class="route-number">0{index + 1}</span>
        <div><strong>{route.label} <span aria-hidden="true">↗</span></strong><small>{route.detail}</small></div>
      </a>
    ))}
  </nav>

  <section class="section start-reading" id="start-reading">
    <div class="container">
      <div class="reading-head">
        <div>
          <p class="eyebrow">从这里开始</p>
          <h2>从具体问题与修复记录开始。</h2>
        </div>
        <a class="text-link" href={withBase('/pitfalls/')}>更多踩坑记录 ↗</a>
      </div>
      <FeaturedReads />
    </div>
  </section>

  <section class="section compact-section">
    <div class="container stack-row" aria-label="技术栈">
      {stackGroups.flatMap((group) => group.items).slice(0, 12).map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section rule" id="projects">
    <div class="container split-section">
      <div class="section-intro">
        <p class="eyebrow">Projects</p>
        <h2 class="section-title">代表项目</h2>
        <p class="section-copy">按个人提交梳理负责事项，记录处理步骤、关键修复与已知限制。</p>
        <a class="text-link" href={withBase('/projects/')}>全部项目</a>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section rule" id="capabilities">
    <div class="container">
      <p class="eyebrow">What I bring</p>
      <h2 class="section-title">具体工作事项</h2>
      <p class="section-copy">以下事项对应项目中的实现与修复，详情保留业务规则和提交记录。</p>
      <div class="capability-grid">
        {capabilities.map((item) => (
          <a class="capability-note" href={withBase(item.href)}>
            <span class="capability-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
            <span class="text-link">{item.project} ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section rule" id="writing">
    <div class="container split-section">
      <div class="section-intro">
        <p class="eyebrow">Writing</p>
        <h2 class="section-title">最近文章</h2>
        <p class="section-copy">记录 Java 后端、系统设计、缓存、消息队列、数据库和线上问题复盘。</p>
        <a class="text-link" href={withBase('/blog/')}>文章归档</a>
      </div>
      <ArticleList articles={articles} />
    </div>
  </section>

  <section class="section rule" id="practice">
    <div class="container">
      <p class="eyebrow">Notes from the work</p>
      <h2 class="section-title">问题与修复记录</h2>
      <p class="section-copy">留下具体问题、修复边界和下一次可以复用的做法。</p>
      <div class="practice-grid">
        {practiceChannels.map((channel) => (
          <div class="practice-column">
            <div class="practice-head">
              <h3>{channel.label}</h3>
              <a class="text-link" href={withBase(channel.href)}>全部笔记 ↗</a>
            </div>
            <ArticleList articles={channel.posts} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section rule" id="ai-skills">
    <div class="container split-section">
      <div class="section-intro">
        <p class="eyebrow">AI Skills</p>
        <h2 class="section-title">给 AI 一套做事的方法。</h2>
      </div>
      <div>
        <p class="section-copy">整理 {skills.length} 个开源 AI Skills：从寻找能力、澄清需求、改进架构，到测试、浏览器验证与视频制作。每项都写清用途、安装方式、调用示例和适用边界。</p>
        <div class="stack-row" aria-label="AI Skills 覆盖方向"><span>技能发现</span><span>需求与设计</span><span>工程质量</span><span>视频创作</span></div>
        <a class="text-link" href={withBase('/ai-skills/')}>阅读 AI Skills 使用指南 ↗</a>
      </div>
    </div>
  </section>

  <section class="section rule" id="resources">
    <div class="container">
      <div class="resource-head">
        <div>
          <p class="eyebrow">Resources</p>
          <h2 class="section-title">常用入口</h2>
        </div>
        <form class="search-box" action="https://www.bing.com/search" method="get" target="_blank">
          <span aria-hidden="true">B</span>
          <input name="q" type="search" placeholder="Bing 搜索技术问题或文档" aria-label="Bing 搜索技术问题或文档" />
        </form>
      </div>
      <div class="resource-grid">
        {
          resourceGroups.flatMap((group) => group.items).map((item) => (
            <a class="resource-card" href={item.href} target="_blank" rel="noreferrer">
              <span>{item.icon}</span>
              <strong>{item.name}</strong>
              <em>{item.description}</em>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reading-routes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding-block: 24px; border-block: 1px solid var(--line); }
  .reading-routes > a { display: flex; align-items: baseline; gap: 14px; padding: 8px 4px; border-radius: 4px; }
  .route-number { color: var(--accent); font: 0.75rem var(--mono); }
  .reading-routes strong { font-size: 0.95rem; }
  .reading-routes strong span { margin-left: 8px; color: var(--accent); }
  .reading-routes small { display: block; margin-top: 7px; color: var(--muted); font-size: 0.8rem; }
  .reading-routes a:hover strong { color: var(--accent-strong); }
  @media (max-width: 700px) { .reading-routes { grid-template-columns: 1fr; gap: 8px; padding-block: 16px; } }
  .start-reading { padding-block: 30px 12px; }
  .reading-head { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; flex-wrap: wrap; margin-bottom: 22px; }
  .reading-head h2 { margin: 0; font-size: clamp(1.15rem, 2vw, 1.6rem); line-height: 1.5; }
  .reading-head .text-link { font-size: 0.84rem; }
  .hero {
    padding-block: clamp(48px, 5vw, 84px) 30px;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 54px;
    align-items: center;
  }

  .hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2rem, 3.45vw, 3.75rem);
    font-weight: 820;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .hero-copy p:not(.eyebrow) {
    max-width: 660px;
    margin-block: 22px 26px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .profile-card {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
    background: color-mix(in srgb, var(--surface), transparent 4%);
    box-shadow: var(--shadow);
  }

  .avatar {
    display: grid;
    width: 62px;
    height: 62px;
    place-items: center;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent-strong), var(--accent));
    color: #fff;
    font-weight: 860;
  }

  .profile-card h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .profile-card p {
    margin: 2px 0 0;
    color: var(--muted);
  }

  dl {
    grid-column: 1 / -1;
    display: grid;
    gap: 0;
    margin: 0;
  }

  dl div {
    border-top: 1px solid var(--line);
    padding-block: 12px;
  }

  dt {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  dd {
    overflow-wrap: anywhere;
    margin: 2px 0 0;
    font-weight: 700;
  }

  .compact-section {
    padding-block: 24px 58px;
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .stack-row span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 12px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .split-section {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 54px;
    align-items: start;
  }

  .section-intro {
    position: sticky;
    top: var(--header-offset);
  }

  .text-link {
    display: inline-flex;
    margin-top: 10px;
    color: var(--accent-strong);
    font-weight: 760;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .capability-grid,
  .practice-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 40px;
    margin-top: 30px;
  }

  .capability-note {
    border-top: 1px solid var(--line-strong);
    padding: 22px 0 12px;
  }

  .capability-number {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .capability-note h3 {
    margin: 10px 0;
    font-size: 1.22rem;
  }

  .capability-note p {
    color: var(--muted);
    margin: 0;
  }

  .capability-note:hover h3 {
    color: var(--accent-strong);
  }

  .practice-column { min-width: 0; }

  .practice-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 18px;
  }

  .practice-head h3 { margin: 0; font-size: 1.3rem; }
  .practice-head .text-link { margin: 0; font-size: 0.86rem; }

  .resource-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: 24px;
    align-items: end;
    margin-bottom: 20px;
  }

  .search-box {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .search-box span {
    display: grid;
    height: 44px;
    place-items: center;
    color: var(--accent-strong);
    font-weight: 860;
  }

  .search-box input {
    width: 100%;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--text);
    border-radius: 999px;
  }

  .resource-card {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 3px 12px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 15px;
    background: var(--surface);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .resource-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent), var(--line) 40%);
    box-shadow: var(--shadow);
  }

  .resource-card span {
    grid-row: span 2;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: 860;
  }

  .resource-card strong {
    line-height: 1.2;
  }

  .resource-card em {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.88rem;
    font-style: normal;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

  @media (max-width: 900px) {
    .hero-layout,
    .split-section,
    .resource-head,
    .capability-grid,
    .practice-grid,
    .project-grid,
    .resource-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .section-intro {
      position: static;
    }

    .hero {
      padding-block-start: 54px;
    }
  }

  @media (min-width: 600px) and (max-width: 900px) {
    .project-grid, .resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  }

  @media (max-width: 620px) {
    .hero-copy h1 {
      font-size: clamp(2rem, 9vw, 3.1rem);
    }
  }
</style>
