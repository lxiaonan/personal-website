---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyCode from '../../components/CopyCode.astro';
import { skillCategories, skillsReviewedOn } from '../../data/skills';
import { withBase } from '../../utils/path';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const routes = [
  { label: '想法还不清楚', name: 'grill-me', detail: '先追问目标与取舍' },
  { label: '准备长期维护', name: 'grill-with-docs', detail: '统一术语，记下重要决策' },
  { label: '代码难改难测', name: 'improve-codebase-architecture', detail: '先调查，再选择重构机会' },
  { label: '要做项目介绍片', name: 'hyperframes', detail: '从脚本分镜到可编辑工程' }
];
---

<BaseLayout title="AI Skills：介绍与使用指南" description={`${skills.length} 个 AI Skills 的中文详细指南：技能发现、需求澄清、架构改进、测试驱动开发、浏览器验证和视频制作，附安装命令与调用示例。`}>
  <section class="section skills-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">AI Skills / A practical field guide</p>
        <h1>让 AI 学会一套方法，<br /><span>把工作做得更扎实。</span></h1>
        <p class="lead">从「不知道用什么」，到「想清楚、做出来、验证好」。整理 {skills.length} 个开源 Skill 的用途、安装方法与真实工作场景，给每一种能力找到合适的位置。</p>
        <div class="button-row">
          <a class="button primary" href="#skill-library">浏览 {skills.length} 个 Skills ↓</a>
          <a class="button" href="#getting-started">第一次怎么用</a>
        </div>
        <p class="review-note">原仓库核对于 <time datetime={skillsReviewedOn}>{skillsReviewedOn}</time> · 中文整理与场景示例</p>
      </div>
      <aside class="route-map" aria-label="Skill 在开发中的位置">
        <p class="eyebrow">从需求到交付</p>
        <ol>
          <li><span>01</span><div><strong>找到能力</strong><small>find-skills</small></div></li>
          <li><span>02</span><div><strong>把问题想清楚</strong><small>grill-me / grill-with-docs</small></div></li>
          <li><span>03</span><div><strong>实现并验证</strong><small>architecture / tdd / agent-browser</small></div></li>
          <li><span>04</span><div><strong>用视频表达成果</strong><small>hyperframes / hyperframes-cli</small></div></li>
        </ol>
        <p>setup-matt-pocock-skills 为工程技能准备项目约定</p>
      </aside>
    </div>
  </section>

  <section class="section rule" id="understand-skills">
    <div class="container intro-grid">
      <div><p class="eyebrow">Understand the basics</p><h2 class="section-title">Skill 到底有什么用？</h2></div>
      <div class="basics">
        <p>Skill 是一份可复用的工作说明，通常以 <code>SKILL.md</code> 为入口，也可以带参考资料、脚本和模板。Agent 在适合的任务中读取它，按照整理好的步骤工作，减少每次从零解释流程的成本。</p>
        <div class="concept-grid">
          <div><h3>提示词：这次做什么</h3><p>告诉 AI 当前目标、背景与限制。使用 Skill 时，具体任务仍然要说明清楚。</p></div>
          <div><h3>Skill：按什么方法做</h3><p>提供操作顺序、检查标准和常见误区，让复杂任务有可复用的做法。</p></div>
          <div><h3>工具 / MCP：靠什么执行</h3><p>连接浏览器、文件或服务。Skill 可以指导调用工具，执行能力仍取决于实际环境。</p></div>
        </div>
        <p class="small-note">它们可以减少遗漏、缩短沟通、积累团队方法；实际效果仍取决于模型、工具权限、项目上下文与验证质量。</p>
      </div>
    </div>
  </section>

  <section class="section rule" id="skill-library">
    <div class="container">
      <div class="library-heading"><div><p class="eyebrow">The skill library</p><h2 class="section-title">按眼前的问题，选一个开始。</h2></div><span class="library-total">{String(skills.length).padStart(2, '0')} SKILLS / {String(Object.keys(skillCategories).length).padStart(2, '0')} CATEGORIES</span></div>
      <div class="library-controls" data-skill-controls hidden>
        <div class="filters" role="group" aria-label="按技能用途筛选">
          <button type="button" data-category="all" aria-pressed="true">全部 <span>{skills.length}</span></button>
          {Object.entries(skillCategories).map(([key, label]) => <button type="button" data-category={key} aria-pressed="false">{label}</button>)}
        </div>
        <label class="skill-search"><span>搜索技能</span><input type="search" placeholder="名称、用途或关键词…" data-skill-search /></label>
      </div>
      <p class="result-count" data-skill-count aria-live="polite" aria-atomic="true">共 {skills.length} 个 Skills · 每项均附详细指南</p>
      <div class="skill-grid">
        {skills.map((skill) => (
          <article class="skill-card" data-skill-card data-category={skill.data.category} data-search={`${skill.data.name} ${skill.data.description} ${skill.data.benefit} ${skill.data.output} ${skill.data.repo} ${skillCategories[skill.data.category]}`.toLowerCase()}>
            <div class="card-meta"><span>{skillCategories[skill.data.category]}</span><span>{String(skill.data.order).padStart(2, '0')}</span></div>
            <h3><a href={withBase(`/ai-skills/${skill.id}/`)}>{skill.data.name}<span aria-hidden="true">↗</span></a></h3>
            <p>{skill.data.description}</p>
            <div class="benefit"><span>带来的价值</span><p>{skill.data.benefit}</p></div>
            <div class="card-footer"><small>{skill.data.repo}</small><a href={withBase(`/ai-skills/${skill.id}/`)}>介绍与用法 →</a></div>
          </article>
        ))}
      </div>
      <p class="empty-state" data-skill-empty hidden>没有找到匹配的 Skill。试试其他关键词，或切换到「全部」。</p>
      <noscript><p class="small-note">已展示全部指南，可以直接打开阅读；启用 JavaScript 后可按类别筛选和搜索。</p></noscript>
    </div>
  </section>

  <section class="section rule" id="getting-started">
    <div class="container intro-grid">
      <div><p class="eyebrow">Your first skill</p><h2 class="section-title">从安装到第一次调用。</h2><p class="section-copy">先选一个能解决当前问题的 Skill，跑通小任务，再逐步组合。</p></div>
      <div class="getting-started">
        <ol class="steps">
          <li><h3>准备支持 Skill 的 Agent</h3><p>确认所用 Agent 支持 Agent Skills，并能访问项目与所需工具。通用安装器当前要求 Node.js 22.20+；具体 Skill 的额外依赖见详细指南。</p></li>
          <li><h3>在项目目录安装</h3><p>默认装到当前项目，安装界面会让你选择 Agent。加 <code>-g</code> 表示用户范围、跨项目使用。以下示例安装技能发现助手：</p><div class="command-block" data-copy-code><pre><code>npx skills add vercel-labs/skills --skill find-skills</code></pre></div><p>Matt Pocock 的部分入口依赖共享 Skill，建议通过技能包安装并保留依赖；HyperFrames 可用核心集安装方式，详见对应指南。</p></li>
          <li><h3>明确写出名称、目标和约束</h3><p>安装完成后，在对话中说明要使用哪项 Skill。支持斜杠命令的宿主可以用 <code>/skill-name</code>，其他环境使用技能选择器或明确点名，入口以实际环境为准。</p><div class="command-block" data-copy-code><pre><code>使用 find-skills，寻找适合 Java 后端项目的测试 Skill。
项目使用 Spring Boot 和 JUnit，希望重点覆盖幂等与异步任务。
请比较候选的适用范围、依赖和产出，并提供原始来源。</code></pre></div></li>
          <li><h3>检查产出，维护版本</h3><p>核对结果是否满足需求，要求 AI 区分已验证结论与推测。安装后未识别时，检查安装范围并刷新技能列表或开启新会话。</p><div class="command-block" data-copy-code><pre><code>npx skills list
npx skills check
npx skills update</code></pre></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section rule" id="choose-a-skill">
    <div class="container">
      <p class="eyebrow">Choose by the problem</p><h2 class="section-title">现在，该用哪一个？</h2>
      <div class="choice-grid">{routes.map((route) => <a href={withBase(`/ai-skills/${route.name}/`)}><span>{route.label}</span><strong>{route.name} ↗</strong><p>{route.detail}</p></a>)}</div>
      <div class="workflow-note"><h3>一条适合后端项目的组合路线</h3><p><a href={withBase('/ai-skills/setup-matt-pocock-skills/')}>配置项目约定</a> → <a href={withBase('/ai-skills/grill-with-docs/')}>澄清需求与决策</a> → <a href={withBase('/ai-skills/tdd/')}>用测试推动实现</a> → <a href={withBase('/ai-skills/agent-browser/')}>验证浏览器交互</a>。</p><p>遇到架构阻力时先做架构调查；交付后需要演示视频，再接入 HyperFrames。根据任务选择需要的环节，无需每次把整套流程跑一遍。</p></div>
    </div>
  </section>

  <section class="section rule" id="questions">
    <div class="container intro-grid">
      <div><p class="eyebrow">Before you begin</p><h2 class="section-title">几个常见问题。</h2></div>
      <div class="faq">
        <details><summary>装了 Skill，就等于安装了工具吗？</summary><p>需要分别确认。例如 agent-browser 还需要 CLI 与浏览器，HyperFrames 还需要 Node.js、FFmpeg 和素材。只有工作说明、没有运行工具时，Agent 只能提供指导或完成部分步骤。</p></details>
        <details><summary>这些 Skill 都能用在 Java 项目吗？</summary><p>需求澄清、领域文档、架构调查和 TDD 方法不局限于语言。Java 项目应沿用自己的 JUnit、构建命令和约定；agent-browser 面向网页操作，HyperFrames 面向视频工程，各自适用于不同交付环节。</p></details>
        <details><summary>要把所有 Skill 都安装吗？</summary><p>按任务选择即可。注意入口 Skill 的依赖：当前 grill-me 调用 grilling，grill-with-docs 组合 grilling 与 domain-modeling。优先通过原仓库的包安装方式保留配套文件，再确认 Agent 实际能发现哪些能力。</p></details>
        <details><summary>这份介绍和原仓库有什么关系？</summary><p>本栏目依据原仓库 README 与 SKILL.md 作中文整理，示例用于说明实际用法，不代表作者或本站已完成相应业务。每篇保留来源链接；上游可能更新命令、依赖和流程，使用时请核对安装版本。</p></details>
      </div>
    </div>
  </section>
  <CopyCode />
</BaseLayout>

<script>
  const controls = document.querySelector<HTMLElement>('[data-skill-controls]');
  const input = document.querySelector<HTMLInputElement>('[data-skill-search]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters [data-category]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-skill-card]'));
  let category = 'all';
  function update() {
    const query = (input?.value ?? '').trim().toLowerCase();
    let count = 0;
    cards.forEach((card) => {
      const matches = (category === 'all' || card.dataset.category === category) && (card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) count++;
    });
    const status = document.querySelector('[data-skill-count]');
    if (status) status.textContent = `当前显示 ${count} / ${cards.length} 个 Skills`;
    const empty = document.querySelector<HTMLElement>('[data-skill-empty]');
    if (empty) empty.hidden = count > 0;
  }
  buttons.forEach((button) => button.addEventListener('click', () => {
    category = button.dataset.category ?? 'all';
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    update();
  }));
  input?.addEventListener('input', update);
  if (controls) controls.hidden = false;
</script>

<style>
  .skills-hero { padding-block: 64px 58px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.7fr); gap: clamp(30px, 6vw, 90px); align-items: center; }
  h1 { margin: 14px 0 22px; font-size: clamp(2rem, 3.5vw, 3.6rem); line-height: 1.35; letter-spacing: -0.025em; }
  h1 span { color: var(--accent-strong); }
  .lead { max-width: 710px; color: var(--muted); font-size: 1.08rem; line-height: 1.9; margin-bottom: 28px; }
  .review-note, .small-note { color: var(--faint); font-size: 0.84rem; line-height: 1.8; }
  .review-note { margin-top: 22px; }
  .route-map { border: 1px solid var(--line); border-top: 3px solid var(--accent); padding: 26px 28px; border-radius: 0 0 12px 12px; background: var(--surface); }
  .route-map ol { list-style: none; padding: 0; margin: 0; }
  .route-map li { display: flex; align-items: baseline; gap: 18px; border-bottom: 1px solid var(--line); padding: 15px 0; }
  .route-map li > span { color: var(--accent); font-family: var(--mono); font-size: 0.78rem; }
  .route-map strong, .route-map small { display: block; }
  .route-map small { margin-top: 4px; color: var(--muted); font-family: var(--mono); font-size: 0.73rem; overflow-wrap: anywhere; }
  .route-map > p:last-child { margin-bottom: 0; font-size: 0.75rem; color: var(--muted); }
  .intro-grid { display: grid; grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .intro-grid > * { min-width: 0; }
  .intro-grid .section-title { font-size: clamp(1.6rem, 2.5vw, 2.25rem); line-height: 1.45; }
  .basics > p:first-child { margin-top: 0; font-size: 1.05rem; color: var(--body-copy); line-height: 1.9; }
  .concept-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 25px; }
  .concept-grid h3 { font-size: 0.96rem; }
  .concept-grid p { font-size: 0.88rem; color: var(--muted); }
  .library-heading { display: flex; justify-content: space-between; gap: 20px; align-items: end; }
  .library-heading h2 { font-size: clamp(1.7rem, 2.9vw, 2.5rem); line-height: 1.4; }
  .library-total { color: var(--faint); font-family: var(--mono); font-size: 0.72rem; white-space: nowrap; }
  .library-controls { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 30px; }
  .library-controls[hidden], .skill-card[hidden] { display: none; }
  .filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .filters button { border: 1px solid var(--line); border-radius: 7px; padding: 9px 13px; background: var(--surface); color: var(--muted); cursor: pointer; font-size: 0.86rem; }
  .filters button[aria-pressed='true'] { background: var(--accent-soft); color: var(--accent-strong); border-color: var(--accent); }
  .filters button span { margin-left: 5px; font-family: var(--mono); }
  .skill-search { display: flex; gap: 10px; align-items: center; color: var(--muted); font-size: 0.82rem; }
  .skill-search input { min-width: 220px; max-width: 100%; border: 1px solid var(--line-strong); border-radius: 7px; padding: 10px 12px; background: var(--surface); color: var(--text); font-size: 0.86rem; }
  .result-count { font-size: 0.78rem; color: var(--faint); margin: 20px 0 14px; }
  .skill-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .skill-card { min-width: 0; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 10px; padding: 23px; background: var(--surface); transition: border-color 160ms ease, transform 160ms ease; }
  .skill-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card-meta { display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--accent-strong); }
  .card-meta span:last-child { font-family: var(--mono); color: var(--faint); }
  .skill-card h3 { font-family: var(--mono); font-size: 1.06rem; line-height: 1.55; overflow-wrap: anywhere; margin: 20px 0 10px; }
  .skill-card h3 a { display: flex; justify-content: space-between; gap: 12px; }
  .skill-card h3 span { flex-shrink: 0; color: var(--accent); }
  .skill-card > p { font-size: 0.9rem; color: var(--muted); margin: 0 0 20px; flex: 1; }
  .benefit { padding: 14px 0; border-top: 1px solid var(--line); }
  .benefit > span { font-size: 0.72rem; font-weight: 700; color: var(--faint); }
  .benefit p { margin: 6px 0 0; font-size: 0.86rem; color: var(--body-copy); }
  .card-footer { display: flex; flex-wrap: wrap; gap: 9px; justify-content: space-between; align-items: center; padding-top: 10px; }
  .card-footer small { color: var(--faint); font-family: var(--mono); font-size: 0.66rem; overflow-wrap: anywhere; }
  .card-footer a { color: var(--accent-strong); font-size: 0.79rem; font-weight: 700; }
  .empty-state { padding: 30px 20px; border: 1px dashed var(--line-strong); color: var(--muted); }
  .steps { padding-left: 24px; margin: 0; }
  .steps > li { padding: 0 0 25px 12px; }
  .steps > li::marker { color: var(--accent); font-family: var(--mono); }
  .steps h3 { margin: 0 0 10px; font-size: 1.1rem; }
  .steps p { color: var(--muted); font-size: 0.94rem; }
  .steps code { font-family: var(--mono); font-size: 0.85em; overflow-wrap: anywhere; }
  .command-block { min-width: 0; }
  .command-block pre { max-width: 100%; margin: 16px 0; padding: 44px 18px 18px; border-radius: 9px; background: #0b1020; color: #edf2ff; overflow-x: auto; font-size: 0.87rem; }
  .choice-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 30px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .choice-grid a { min-width: 0; padding: 24px; background: var(--surface); border-right: 1px solid var(--line); }
  .choice-grid a:last-child { border-right: 0; }
  .choice-grid a:hover { background: var(--accent-soft); }
  .choice-grid span { color: var(--muted); font-size: 0.82rem; }
  .choice-grid strong { display: block; margin-top: 16px; overflow-wrap: anywhere; font-family: var(--mono); color: var(--accent-strong); font-size: 0.92rem; }
  .choice-grid p { font-size: 0.84rem; color: var(--muted); margin-bottom: 0; }
  .workflow-note { border-left: 3px solid var(--accent); padding: 5px 24px; margin-top: 32px; }
  .workflow-note h3 { font-size: 1rem; }
  .workflow-note p { font-size: 0.92rem; color: var(--muted); }
  .workflow-note a { color: var(--accent-strong); text-decoration: underline; text-underline-offset: 4px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 19px 0; }
  .faq details:first-child { border-top: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-size: 1rem; font-weight: 700; }
  .faq p { color: var(--muted); font-size: 0.94rem; }
  @media (max-width: 1120px) { .skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .intro-grid { gap: 32px; } .choice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .choice-grid a { border-bottom: 1px solid var(--line); } }
  @media (max-width: 760px) { .hero-grid, .intro-grid { grid-template-columns: 1fr; gap: 28px; } .skills-hero { padding-top: 40px; } .route-map { max-width: 100%; } .library-heading { flex-wrap: wrap; } .concept-grid { gap: 16px; } .skill-search { width: 100%; } .skill-search input { min-width: 0; flex: 1; } }
  @media (max-width: 520px) { .skill-grid, .concept-grid, .choice-grid { grid-template-columns: 1fr; } .skill-card { padding: 21px; } .route-map { padding: 22px; } .choice-grid a { border-right: 0; } .steps { padding-left: 20px; } .steps > li { padding-left: 4px; } }
</style>
