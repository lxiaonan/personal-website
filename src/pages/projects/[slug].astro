---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectSlug } from '../../utils/projects';
import { withBase } from '../../utils/path';
import ArticleList from '../../components/ArticleList.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: projectSlug(project.id) },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedNotes = (await getCollection('blog', ({ data }) => !data.draft && data.project?.id === project.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="project-detail section">
    <div class="container detail-layout">
      <aside class="project-rail" aria-label="项目概要">
        <a class="back-link" href={withBase('/projects/')}>返回项目</a>
        <p class="eyebrow">{project.data.status}</p>
        <h1>{project.data.title}</h1>
        <p>{project.data.summary}</p>
        <dl>
          <div>
            <dt>周期</dt>
            <dd>{project.data.period}</dd>
          </div>
          <div>
            <dt>角色</dt>
            <dd>{project.data.role}</dd>
          </div>
        </dl>
        <ul class="chip-list">
          {project.data.stack.map((item) => <li class="chip">{item}</li>)}
        </ul>
        {project.data.skills.length > 0 && (
          <div class="skills-panel">
            <p class="eyebrow">What I bring</p>
            <h2>个人能力</h2>
            <ul>{project.data.skills.map((skill) => <li>{skill}</li>)}</ul>
          </div>
        )}
      </aside>

      <div class="project-body">
        <section class="impact-panel" aria-label="交付能力">
          <p class="eyebrow">Delivered</p>
          <ul>
            {project.data.metrics.map((metric) => <li>{metric}</li>)}
          </ul>
        </section>
        <div class="prose">
          <Content />
        </div>
        {relatedNotes.length > 0 && (
          <section class="project-notes" aria-label="相关实践记录">
            <p class="eyebrow">Lessons from this project</p>
            <h2>相关实践记录</h2>
            <ArticleList articles={relatedNotes} />
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .detail-layout {
    display: grid;
    grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
    gap: clamp(36px, 5vw, 80px);
    align-items: start;
  }

  .project-rail {
    position: sticky;
    top: 108px;
    max-height: calc(100vh - 132px);
    overflow-y: auto;
    scrollbar-width: thin;
    padding-right: 6px;
    display: grid;
    gap: 16px;
  }

  .back-link {
    display: inline-flex;
    width: fit-content;
    color: var(--muted);
    font-weight: 720;
  }

  .project-rail h1 {
    margin: 0;
    font-size: clamp(1.8rem, 2.5vw, 2.5rem);
    letter-spacing: 0;
    line-height: 1.3;
  }

  .project-rail p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
  }

  .skills-panel {
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }

  .skills-panel h2 {
    margin: 0 0 10px;
    font-size: 1rem;
  }

  .skills-panel ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  dl {
    display: grid;
    gap: 0;
    margin: 10px 0 0;
    border-top: 1px solid var(--line);
  }

  dl div {
    border-bottom: 1px solid var(--line);
    padding-block: 13px;
  }

  dt {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  dd {
    margin: 2px 0 0;
    color: var(--text);
    font-weight: 720;
    line-height: 1.45;
  }

  .project-body .prose { max-width: none; }

  .project-body {
    display: grid;
    gap: 34px;
    min-width: 0;
  }

  .project-notes h2 {
    margin: 0 0 20px;
    font-size: 1.4rem;
  }

  .impact-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    background: color-mix(in srgb, var(--surface), transparent 4%);
  }

  .impact-panel ul {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .impact-panel li {
    position: relative;
    padding-left: 18px;
    color: var(--text);
    font-weight: 690;
    line-height: 1.55;
  }

  .impact-panel li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    content: '';
  }

  @media (max-width: 900px) {
    .detail-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .project-rail {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }
</style>
