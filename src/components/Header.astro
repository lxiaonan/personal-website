---
import { navItems, profile } from '../data/site';
import { withBase } from '../utils/path';

interface Props {
  activePath?: string;
}

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.props.activePath ?? (Astro.url.pathname.replace(basePath, '') || '/');

function isActivePath(href: string) {
  if (href === '/') {
    return currentPath === '/';
  }

  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="返回首页">
      <span class="brand-mark">YN</span>
      <span>
        <strong>{profile.name}</strong>
        <small>{profile.handle}</small>
      </span>
    </a>

    <nav aria-label="主导航">
      {
        navItems.map((item) => {
          const active = isActivePath(item.href);
          return (
            <a class:list={{ active }} href={withBase(item.href)} aria-current={active ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <a class="search-link" href={withBase('/search/')} aria-label="站内搜索" aria-current={isActivePath('/search/') ? 'page' : undefined}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
      </a>
      <button class="theme-toggle" type="button" aria-label="切换深浅色主题" data-theme-toggle>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  function updateThemeLabel() {
    toggle?.setAttribute('aria-label', root.dataset.theme === 'dark' ? '切换为浅色主题' : '切换为深色主题');
    toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  }
  updateThemeLabel();

  // Reveal the current section in the horizontally scrollable mobile navigation.
  const navigation = document.querySelector<HTMLElement>('.site-header nav');
  const activeLink = navigation?.querySelector<HTMLElement>('[aria-current="page"]');
  if (navigation && activeLink && navigation.scrollWidth > navigation.clientWidth) {
    navigation.scrollLeft = activeLink.offsetLeft - navigation.offsetLeft - 16;
  }

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    updateThemeLabel();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg), transparent 8%);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    display: inline-flex;
    min-width: 176px;
    align-items: center;
    gap: 10px;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.83rem;
    font-weight: 860;
  }

  .brand strong,
  .brand small {
    display: block;
    line-height: 1.2;
  }

  .brand small {
    color: var(--muted);
    font-size: 0.76rem;
  }

  nav {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 4px;
  }

  nav a {
    position: relative;
    border-radius: 8px;
    padding: 10px;
    min-height: 44px;
    white-space: nowrap;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 680;
    transition:
      background 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  nav a:hover {
    background: var(--surface-soft);
    color: var(--text);
  }

  nav a.active {
    background: color-mix(in srgb, var(--accent-soft), var(--surface) 20%);
    color: var(--accent-strong);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent), transparent 78%);
  }

  nav a.active::after {
    position: absolute;
    right: 12px;
    bottom: 4px;
    left: 12px;
    height: 2px;
    border-radius: 999px;
    background: var(--accent);
    content: '';
  }

  .header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .search-link[aria-current], .search-link:hover { color: var(--accent-strong); background: var(--accent-soft); }

  .theme-toggle, .search-link {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    .header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: auto;
      padding-block: 10px 4px;
      align-items: center;
      gap: 8px;
    }

    .brand {
      min-width: 0;
    }

    .brand-mark { flex-shrink: 0; }
    .brand > span:last-child { min-width: 0; }
    .brand small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .header-actions { grid-column: 2; grid-row: 1; }

    nav {
      order: 3;
      grid-column: 1 / -1;
      min-width: 0;
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
      padding: 3px 2px 6px;
      scroll-padding-inline: 8px;
    }

  }

  @media (max-width: 520px) { nav a { font-size: 0.84rem; } }
</style>
