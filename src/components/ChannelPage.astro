---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from './ArticleList.astro';
import { channels } from '../data/channels';
import { withBase } from '../utils/path';

interface Props {
  category: 'pitfall' | 'ai-development';
  description: string;
  approach: string;
  steps: string[];
}

const { category, description, approach, steps } = Astro.props;
const channel = channels[category];
const articles = (await getCollection('blog', ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={channel.label} description={description}>
  <section class="section channel-page">
    <div class="container">
      <header class="channel-hero">
        <p class="eyebrow">{channel.eyebrow}</p>
        <h1 class="section-title">{channel.label}。</h1>
        <p class="section-copy">{description}</p>
      </header>
      <div class="channel-layout">
        <aside class="channel-aside">
          <p class="eyebrow">How I reflect</p>
          <h2>{approach}</h2>
          <ol>{steps.map((step) => <li>{step}</li>)}</ol>
          <a class="project-link" href={withBase('/projects/')}>回到项目，看完整上下文 ↗</a>
        </aside>
        <div class="channel-main">
          <p class="channel-count">{String(articles.length).padStart(2, '0')} 篇实践记录</p>
          {articles.length > 0 ? <ArticleList articles={articles} /> : <p class="empty-state">实践记录正在整理中。</p>}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .channel-page { padding-block-start: 64px; }
  .channel-hero { max-width: 820px; margin-bottom: 42px; }
  .channel-hero .section-copy { font-size: 1.08rem; line-height: 1.8; }
  .channel-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: 48px;
  }
  .channel-aside {
    position: sticky;
    top: 108px;
    border-top: 2px solid var(--accent);
    padding-top: 20px;
  }
  .channel-aside h2 { margin: 0; font-size: 1.15rem; line-height: 1.6; }
  .channel-aside ol { margin: 18px 0 24px; padding-left: 22px; color: var(--muted); }
  .channel-aside li { padding-left: 4px; margin-block: 10px; font-size: 0.9rem; }
  .channel-aside li::marker { color: var(--accent); font-family: var(--mono); }
  .project-link { color: var(--accent-strong); font-size: 0.86rem; font-weight: 700; }
  .project-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .channel-main { min-width: 0; }
  .channel-count { margin: 0 0 12px; color: var(--faint); font-family: var(--mono); font-size: 0.8rem; }
  .empty-state { color: var(--muted); }
  @media (max-width: 900px) {
    .channel-layout { grid-template-columns: 1fr; gap: 30px; }
    .channel-aside { position: static; }
    .channel-aside ol { display: flex; flex-wrap: wrap; gap: 0 34px; }
    .channel-hero { margin-bottom: 28px; }
  }
</style>
